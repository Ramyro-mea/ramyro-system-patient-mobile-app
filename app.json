{
  "expo": {
    "name": "Ramyro Patient Portal",
    "slug": "ramyro-patient-portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ramyro-patient-portal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ramyro.patientportal",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Ramyro Patient Portal connects to your healthcare provider on the local development network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.ramyro.patientportal",
      "adaptiveIcon": {
        "backgroundColor": "#123D63",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ramyro-logo-light2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f8fafc",
          "dark": {
            "image": "./assets/images/ramyro-logo.png",
            "backgroundColor": "#020617"
          }
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Ramyro Patient Portal to use your camera to capture a document for your reservation.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "defaultChannel": "visit-admission"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30f73d77-113e-480f-9a44-30708657532a"
      }
    },
    "owner": "muhannad-abdallah"
  }
}
